# ONLYCHAIN — copy to .env.local. Everything has a working default for a local
# Hardhat node started with `npm run node` + `npm run seed` in chain/.

# The chain the browser talks to: 4663 = Robinhood Chain, 31337 = local Hardhat.
NEXT_PUBLIC_ONLYCHAIN_CHAIN_ID=31337
NEXT_PUBLIC_ONLYCHAIN_RPC_URL=http://127.0.0.1:8766
# The OnlyChain hub and the $ONLY token. On a fresh local node the seed script
# deploys them at these two addresses (the token at deployer nonce 0, the hub at nonce 1).
NEXT_PUBLIC_ONLYCHAIN_HUB=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_ONLYCHAIN_TOKEN=0x5FbDB2315678afecb367f032d93F642f64180aa3
# The Pons V2 bonding curve $ONLY trades on (buy with ETH inside the site). Locally: the mock curve at deployer nonce 2.
NEXT_PUBLIC_ONLYCHAIN_CURVE=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
# A page to buy $ONLY elsewhere (a DEX after graduation). Shown when the curve is not configured or has graduated.
NEXT_PUBLIC_ONLYCHAIN_BUY_URL=
# Optional: the page to bridge ETH out of Robinhood Chain (shown in the "Send" dialog when cashing out).
NEXT_PUBLIC_ONLYCHAIN_BRIDGE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3766
# ETH/USD comes from Pyth (Hermes with PYTH_API_KEY, else the last on-chain print). Local demo rate:
# PYTH_API_KEY=
ONLYCHAIN_ETH_USD=2500
# Optional: a WalletConnect project id (free at cloud.reown.com) adds mobile wallets by QR code.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server side (read at runtime, never inlined). Defaults to the public values above.
ONLYCHAIN_CHAIN_ID=
ONLYCHAIN_RPC_URL=
ONLYCHAIN_HUB=
ONLYCHAIN_TOKEN=
# Operator wallets (comma-separated): they see /ops (reports, verify, suspend). Unset on the local chain = everyone.
OPS_ADDRESSES=
# Set to 0 to disable the per-wallet rate limits (tests).
ONLYCHAIN_RATE_LIMIT=
# Signs the session cookie. Required in production (16+ chars); a random
# per-process secret is used otherwise and sessions die with the server.
SESSION_SECRET=
# SQLite file. Default ./data/onlychain.db; on a read-only host it falls back
# to the OS temp dir and /api/health says `ephemeral: true`.
ONLYCHAIN_DB_PATH=
# Uploaded media folder. Default ./data/uploads (same fallback rule).
ONLYCHAIN_UPLOAD_DIR=
# Set to 1 to skip the sample creators when the database is created.
ONLYCHAIN_NO_SEED=
